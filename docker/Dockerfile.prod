FROM localhost/jiangyin_core:latest

SHELL ["/bin/bash", "-c"]

ENV DEBIAN_FRONTEND=noninteractive
ENV GAZEBO_PLUGIN_PATH=/opt/ros/noetic/lib
ENV GAZEBO_MODEL_PATH=/ws/src/mid360_gazebo/models:/home/user/.gazebo/models
ENV GAZEBO_RESOURCE_PATH=/ws/src/mid360_gazebo/models:/usr/share/gazebo-11/models:/home/user/.gazebo/models

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpcl-dev \
    ros-noetic-gazebo-msgs \
    ros-noetic-gazebo-ros \
    ros-noetic-gazebo-plugins \
    ros-noetic-gazebo-ros-control \
    ros-noetic-velodyne-gazebo-plugins \
    ros-noetic-plotjuggler \
    ros-noetic-plotjuggler-ros \
    && rm -rf /var/lib/apt/lists/*

RUN for so in /opt/ros/noetic/lib/*.so; do \
        ln -sf "$so" "/usr/lib/x86_64-linux-gnu/gazebo-11/plugins/$(basename $so)"; \
    done 2>/dev/null || true

COPY src/ /ws/src/
COPY scripts/start_jy2026.sh /opt/start_jy2026.sh

WORKDIR /ws

RUN rm -f /ws/src/ego-planner-v2/CATKIN_IGNORE && \
    if [ -f /ws/src/libs/livox_ros_driver2/package_ROS1.xml ]; then \
        cp -f /ws/src/libs/livox_ros_driver2/package_ROS1.xml /ws/src/libs/livox_ros_driver2/package.xml; \
    fi

RUN /bin/bash -c "source /opt/ros/noetic/setup.bash && catkin_make -j\$(nproc) -DROS_EDITION=ROS1 2>&1" || \
    /bin/bash -c "source /opt/ros/noetic/setup.bash && catkin_make -j\$(nproc) -DROS_EDITION=ROS1 2>&1 | tail -80"

RUN /bin/bash -c "source /opt/ros/noetic/setup.bash && source /ws/devel/setup.bash && \
    mkdir -p /ws/src/RA-LIO/build && cd /ws/src/RA-LIO/build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -Dlivox_ros_driver2_DIR=/ws/devel/share/livox_ros_driver2/cmake && \
    make -j\$(nproc) && \
    cp -rn devel/bin/* /ws/devel/bin/ 2>/dev/null || true; \
    cp -rn devel/lib/* /ws/devel/lib/ 2>/dev/null || true; \
    cp -rn devel/share/* /ws/devel/share/ 2>/dev/null || true; \
    echo 'RA-LIO built and merged into /ws/devel/'"

RUN echo "source /ws/devel/setup.bash" >> /root/.bashrc
RUN chmod +x /opt/start_jy2026.sh

CMD ["bash", "/opt/start_jy2026.sh"]
