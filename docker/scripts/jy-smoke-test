#!/usr/bin/env bash
# ============================================================================
# jy-smoke-test — Authoritative runtime smoke test for Jiangyin2026 SITL
#
# Purpose: Prove that the baked PX4 SITL single-container image works at runtime.
#   - gzserver is alive
#   - px4 binary is alive
#   - /mavros/imu/data (sensor stream) is publishing
#   - /mavros/state is connected
#
# This is the authoritative gate — static greps can't catch a broken world/plugin.
# The test runs *inside* the SITL container where ROS_MASTER_URI=localhost.
#
# Usage:
#   bash scripts/jy-smoke-test                 # run standalone against local ROS
#
# Exit codes:
#   0 — all asserts passed
#   1 — one or more asserts failed (output explains which + hint)
#
# Constraints:
#   Total budget ~45s.  Idempotent — safe to run when SITL is already up.
#   Self-contained: only bash, rostopic, pgrep, timeout, grep, seq, date.
# ============================================================================
set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
ROSTOPIC_MAVROS="/mavros/state"
ROSTOPIC_IMU="/mavros/imu/data"

ROS_CHECK_TIMEOUT=10       # per rostopic check
MAVROS_CHECK_TIMEOUT=10    # per mavros check
ROS_START_TIMEOUT=30       # wait for roscore before checks
IMU_SAMPLE_TIMEOUT=5       # give IMU a couple cycles to publish

TOTAL_STARTUP_TIMEOUT=45   # hard wall around entire script
HOSTNAME="${HOSTNAME:-}"
SITL_SCRIPT="jy-docker.sh"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
_fail() {
  local msg="$1"
  echo "[jy-smoke-test] FAIL: ${msg}" >&2
  echo ""
  echo "Hint: Make sure SITL is running inside the container."
  echo "  Container uses ROS_MASTER_URI=http://localhost:11311"
  echo "  Components:   gzserver + bin/px4 + mavros"
  if [[ -n "${HOSTNAME}" ]]; then
    echo "  Container hostname: ${HOSTNAME}"
    echo "  Check logs:  docker logs ${HOSTNAME}"
    echo "  Inside container, verify: pgrep -fa gzserver"
  fi
  echo "  If running outside, start with:"
  echo "    ${SITL_SCRIPT} sitl"
  echo ""
  exit 1
}

_ok() {
  echo "[jy-smoke-test] PASS"
  exit 0
}

# ---------------------------------------------------------------------------
# 1. Reachability: is roscore / rostopic alive?
# ---------------------------------------------------------------------------
echo "[jy-smoke-test] Checking ROS reachability …"

_ros_reachable() {
  timeout "${ROS_CHECK_TIMEOUT}" rostopic list >/dev/null 2>&1
}

if _ros_reachable; then
  echo "[jy-smoke-test]  roscore reachable"
else
  # Caller may have already started SITL but master wasn't ready yet —
  # retry a couple more times within the budget.
  _ros_retries=3
  _ros_retrying=true
  while [[ ${_ros_retries} -gt 0 ]]; do
    sleep 2
    if _ros_reachable; then
      _ros_retrying=false
      echo "[jy-smoke-test]  roscore reachable after brief wait"
      break
    fi
    _ros_retries=$((_ros_retries - 1))
  done
  if [[ "${_ros_retrying}" == "true" ]]; then
    echo "[jy-smoke-test]  roscore not reachable" >&2
    # The SITL container or jy-docker.sh may not have been started yet.
    if command -v "${SITL_SCRIPT}" >/dev/null 2>&1; then
      echo "  Suggestion: run '${SITL_SCRIPT} sitl' then re-run this test."
    else
      echo "  Suggestion: Start the SITL container first."
      echo "    docker run -h jy-sim localhost/jiangyin_jy2026"
      echo "    # or:    podman-compose -f docker/compose.yml up"
    fi
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# 2. Assert: gzserver is alive
# ---------------------------------------------------------------------------
echo "[jy-smoke-test] Assert: gzserver alive …"

if timeout 5 pgrep -f gzserver >/dev/null 2>&1; then
  echo "[jy-smoke-test]  gzserver: ✓"
else
  _fail "gzserver not found — Gazebo may have crashed or not started"
fi

# ---------------------------------------------------------------------------
# 3. Assert: px4 binary is alive
# ---------------------------------------------------------------------------
echo "[jy-smoke-test] Assert: px4 binary alive …"

if timeout 5 pgrep -f 'bin/px4' >/dev/null 2>&1; then
  echo "[jy-smoke-test]  px4: ✓"
else
  _fail "px4 binary not found — PX4 SITL may have crashed or not started"
fi

# ---------------------------------------------------------------------------
# 4. Assert: /mavros/imu/data is publishing (PX4 sensor stream flows via MAVROS)
# ---------------------------------------------------------------------------
echo "[jy-smoke-test] Assert: ${ROSTOPIC_IMU} publishing …"

_imu_ok=false
for _attempt in 1 2 3; do
  _t0="$(date +%s)"
  # Use rostopic echo -n1 with a hard timeout.
  # sensor_msgs/Imu has a recognizable 'header' / 'orientation' field.
  if timeout "${IMU_SAMPLE_TIMEOUT}" \
       rostopic echo -n1 "${ROSTOPIC_IMU}" 2>/dev/null \
       | grep -q 'orientation'; then
    _t1="$(date +%s)"
    _latency="$((_t1 - _t0))"
    _imu_ok=true
    break
  fi
  # Also check that the topic simply exists (even if first message is empty).
  if timeout "${IMU_SAMPLE_TIMEOUT}" \
       rostopic info "${ROSTOPIC_IMU}" >/dev/null 2>&1; then
    # Topic exists — check if there's a publisher.
    if rostopic info "${ROSTOPIC_IMU}" 2>/dev/null \
         | grep -q 'Publisher count: [1-9]'; then
      _t1="$(date +%s)"
      _latency="$((_t1 - _t0))"
      _imu_ok=true
      break
    fi
  fi
  sleep 1
done

if [[ "${_imu_ok}" == "true" ]]; then
  echo "[jy-smoke-test]  ${ROSTOPIC_IMU}: ✓  (${_latency}s to first message)"
else
  _fail "${ROSTOPIC_IMU} not available — check that:
    1. PX4 SITL is running:  pgrep -fa bin/px4
    2. MAVROS is connected:  /mavros/state -> connected: True
    3. MAVLink link on 14557:  ss -ulnp | grep 14557"
fi

# ---------------------------------------------------------------------------
# 5. Assert: /mavros/state shows connected: True
# ---------------------------------------------------------------------------
echo "[jy-smoke-test] Assert: /mavros/state connected …"

_mavros_ok=false
for _attempt in 1 2 3; do
  if timeout "${MAVROS_CHECK_TIMEOUT}" \
       rostopic echo -n1 "${ROSTOPIC_MAVROS}" 2>/dev/null \
       | grep -q 'connected: True'; then
    _mavros_ok=true
    break
  fi
  sleep 1
done

if [[ "${_mavros_ok}" == "true" ]]; then
  echo "[jy-smoke-test]  /mavros/state: ✓  (connected)"
else
  _fail "/mavros/state not connected — check MAVLink link:
    1. MAVROS launched with:  fcu_url:=udp://:14540@127.0.0.1:14557
    2. PX4 listening on 14557:  ss -ulnp | grep 14557
    3. MAVROS node alive:      rosnode list | grep mavros"
fi

# ---------------------------------------------------------------------------
# Success
# ---------------------------------------------------------------------------
echo ""
echo "  Metrics:"
echo "    gzserver:   ✓"
echo "    px4:        ✓"
echo "    imu:        ✓  (${ROSTOPIC_IMU})"
echo "    mavros:     ✓"

_ok
