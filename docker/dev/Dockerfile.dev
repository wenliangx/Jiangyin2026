ARG DEV_BASE=localhost/jiangyin_dev:v0.2
FROM ${DEV_BASE}

ENV DEBIAN_FRONTEND=noninteractive
ENV GAZEBO_PLUGIN_PATH=/opt/ros/noetic/lib

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The shared development base provides ROS Noetic, CMake, clangd, Gazebo and
# compiler tooling. Project-specific third-party dependencies stay versioned
# as repository debs produced by docker/Dockerfile.debs.
COPY deb/jiangyin-casadi-dev_*.deb \
     deb/jiangyin-livox-sdk2-dev_*.deb \
     deb/jiangyin-livox-ros-driver2_*.deb \
     deb/jiangyin-sophus-dev_*.deb \
     /tmp/jiangyin-debs/
RUN dpkg -i /tmp/jiangyin-debs/*.deb \
    && rm -rf /tmp/jiangyin-debs \
    && ldconfig \
    && source /opt/ros/noetic/setup.bash \
    && command -v catkin_make \
    && command -v clangd \
    && test -f /opt/ros/noetic/share/livox_ros_driver2/cmake/livox_ros_driver2Config.cmake

COPY docker/dev/scripts/start_jy2026.sh /opt/start_jy2026.sh
COPY docker/dev/scripts/jy-sim-control.sh /usr/local/bin/jy-sim-control
COPY docker/dev/scripts/jy-stack.sh /usr/local/bin/jy-stack
RUN chmod +x /opt/start_jy2026.sh /usr/local/bin/jy-sim-control /usr/local/bin/jy-stack \
    && ln -sf /usr/local/bin/jy-sim-control /usr/local/bin/jy-takeoff \
    && ln -sf /usr/local/bin/jy-sim-control /usr/local/bin/jy-land \
    && ln -sf /usr/local/bin/jy-sim-control /usr/local/bin/jy-reset \
    && ln -sf /usr/local/bin/jy-stack /usr/local/bin/jy-start-stack

WORKDIR /ws
CMD ["bash", "/opt/start_jy2026.sh", "--dev"]
