<?xml version="1.0"?>
<launch>
  <!-- Gazebo empty world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" default="$(find mid360_gazebo)/worlds/empty.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Spawn MID360 model -->
  <node name="spawn_mid360" pkg="gazebo_ros" type="spawn_model" output="screen"
    args="-sdf -file $(find mid360_gazebo)/models/mid360/model.sdf -model livox_mid360"/>

  <!-- Bridge: Gazebo PointCloud2 → Livox CustomMsg -->
  <node name="mid360_bridge" pkg="mid360_gazebo" type="mid360_bridge.py" output="screen">
    <param name="horizontal_samples" value="720"/>
    <param name="vertical_samples" value="64"/>
    <param name="scan_rate" value="10.0"/>
    <param name="lidar_id" value="0"/>
  </node>

  <!-- Pose comparison: LiDAR odometry vs Gazebo ground truth -->
  <node name="pose_comparison" pkg="mid360_gazebo" type="pose_comparison.py" output="screen">
    <param name="publish_rate" value="10.0"/>
    <param name="print_interval" value="0.5"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- Optional: spawn a simple environment with obstacles for mapping -->
  <arg name="with_environment" default="true"/>
  <group if="$(arg with_environment)">
    <node name="spawn_obstacles" pkg="gazebo_ros" type="spawn_model" output="screen"
      args="-sdf -model environment -namespace ''
        -param environment_sdf"/>
  </group>
</launch>
