<?xml version="1.0"?>

<launch>

    <arg name="start_mavros" default="true"/>
    <arg name="fcu_url" default="/dev/ttyACM0:921600"/>
    <arg name="nmpc_hover_thrust" default="0.500"/>

    <include if="$(arg start_mavros)" file="$(find mavros)/launch/px4.launch">
       
       <arg name="fcu_url" value="$(arg fcu_url)" />
    
    </include>
    
    <node pkg="fsm_ctrl" type="flight_fsm" name="flight_fsm" output="screen">
       
        <remap from = "~odom"        to ="/camera/odom/sample"/>

        <param name = "nmpc_hover_thrust" type = "double" value = "$(arg nmpc_hover_thrust)" />

        <!-- MissionMachine/Super waypoint upload. Generate this file with:
             rosrun fsm_ctrl record_super_waypoints.py _output_file:=/path/to/mission.yaml -->
        <param name="mission_super_waypoints_file"
               value="$(find fsm_ctrl)/config/validated/mission_super_waypoints.validated.yaml"
               type="string"/>
        <param name="mission_waypoint_manifest"
               value="$(find fsm_ctrl)/config/validated/waypoint_validation_manifest.yaml"
               type="string"/>
        <param name="mission_waypoint_validator"
               value="$(find fsm_ctrl)/scripts/validate_super_waypoints.py"
               type="string"/>
        <param name="mission_super_arrival_tolerance" value="0.60" type="double"/>
        <param name="vision_control_topic" value="/vision/control" type="string"/>
        <param name="target_recognition_topic" value="/vision/target/result" type="string"/>

        <!-- 视觉闭环降落。swap=false 时 dx->x、dy->y；swap=true 时
             dy->x、dx->y。x_sign/y_sign 分别用于翻转飞行坐标轴方向。 -->
        <param name="landing_valid_timeout" value="0.25" type="double"/>
        <param name="landing_align_px_threshold" value="50.0" type="double"/>
        <param name="landing_xy_step" value="0.03" type="double"/>
        <param name="landing_lock_min_tag_count" value="4" type="int"/>
        <param name="landing_adjust_duration_tag1" value="1.2" type="double"/>
        <param name="landing_adjust_duration_tag2" value="1.0" type="double"/>
        <param name="landing_adjust_duration_tag3" value="0.8" type="double"/>
        <param name="landing_adjust_duration_tag4" value="0.6" type="double"/>
        <param name="landing_adjust_duration_tag5" value="0.4" type="double"/>
        <param name="landing_swap_xy" value="true" type="bool"/>
        <param name="landing_x_sign" value="1.0" type="double"/>
        <param name="landing_y_sign" value="1.0" type="double"/>
        <param name="landing_descent_rate" value="0.3" type="double"/>
        <param name="landing_min_z" value="-0.03" type="double"/>
        <param name="landing_reference_z" value="-0.15" type="double"/>
        <param name="landing_tolerance_z" value="0.25" type="double"/>

        <!-- Current NMPC cost weights. -->
        <param name = "nmpc_Qposx" type = "double" value = "100.0" />
        <param name = "nmpc_Qposy" type = "double" value = "100.0" />
        <param name = "nmpc_Qposz" type = "double" value = "70.0" />

        <param name = "nmpc_Qvelx" type = "double" value = "4.0" />
        <param name = "nmpc_Qvely" type = "double" value = "4.0" />
        <param name = "nmpc_Qvelz" type = "double" value = "2.0" />

        <param name = "nmpc_Qquatx" type = "double" value = "1.0" />
        <param name = "nmpc_Qquaty" type = "double" value = "1.0" />
        <param name = "nmpc_Qquatz" type = "double" value = "10.0" />

        <param name = "nmpc_Rwx" type = "double" value = "0.45" />
        <param name = "nmpc_Rwy" type = "double" value = "0.85" />
        <param name = "nmpc_Rwz" type = "double" value = "0.45" />
        <param name = "nmpc_RtotalF" type = "double" value = "0.15" />

    </node>

</launch>
