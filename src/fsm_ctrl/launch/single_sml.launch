<?xml version="1.0"?>

<launch>

    <arg name="start_mavros" default="true"/>
    <arg name="fcu_url" default="/dev/ttyACM0:921600"/>

    <include if="$(arg start_mavros)" file="$(find mavros)/launch/px4.launch">
       
       <arg name="fcu_url" value="$(arg fcu_url)" />
    
    </include>
    
    <node pkg="fsm_ctrl" type="single_offboard_sml" name="single_offboard_fsm" output="screen">
       
        <remap from = "~odom"        to ="/camera/odom/sample"/>

        <!-- LYX -->
        <!-- <rosparam file="$(find fsm_ctrl)/config/traj_waypoints.yaml" command="load" /> --><!-- 文件不存在，已注释；NMPC悬停测试不需要此文件 -->
        <!-- LYX -->

        <param name="kp_x" value="2.0" type="double"/>
        <param name="kp_y" value="2.0" type="double"/>
        <param name="kp_z" value="4.0" type="double"/>
        <param name="kp_yaw" value="0.0" type="double"/>

        <param name="kpi_x" value="0.2" type="double"/>
        <param name="kpi_y" value="0.2" type="double"/>
        <param name="kpi_z" value="0.4" type="double"/>
        <param name="kpi_yaw" value="0.0" type="double"/>

        <param name="kpd_x" value="0.0" type="double"/>
        <param name="kpd_y" value="0.0" type="double"/>
        <param name="kpd_z" value="0.0" type="double"/>
        <param name="kpd_yaw" value="0.0" type="double"/>

        <param name="kv_x" value="4.0" type="double"/>
        <param name="kv_y" value="4.0" type="double"/>
        <param name="kv_z" value="6.0" type="double"/>
        <param name="kv_yaw" value="0.0" type="double"/>

        <param name="kvi_x" value="0.0" type="double"/>
        <param name="kvi_y" value="0.0" type="double"/>
        <param name="kvi_z" value="0.0" type="double"/>
        <param name="kvi_yaw" value="0.0" type="double"/>

        <param name="kvd_x" value="4.0" type="double"/>
        <param name="kvd_y" value="4.0" type="double"/>
        <param name="kvd_z" value="20.0" type="double"/>
        <param name="kvd_yaw" value="0.0" type="double"/>

        <!-- <param name = "nmpc_mQ_py" type = "double" value = "20" />
        <param name = "nmpc_mQ_px" type = "double" value = "20" />
        <param name = "nmpc_mQ_pz" type = "double" value = "50" />
        <param name = "nmpc_mQ_vx" type = "double" value = "1.0" />
        <param name = "nmpc_mQ_vy" type = "double" value = "1.0" />
        <param name = "nmpc_mQ_vz" type = "double" value = "1.0" />
        <param name = "nmpc_mQ_q1" type = "double" value = "1.0" />
        <param name = "nmpc_mQ_q2" type = "double" value = "1.0" />
        <param name = "nmpc_mQ_q3" type = "double" value = "1.0" />
        <param name = "nmpc_mQ_q4" type = "double" value = "1.0" />
        <param name = "nmpc_mR_a_BZ" type = "double"  value = "0.1" />
        <param name = "nmpc_mR_roll" type = "double"  value = "0.1" />
        <param name = "nmpc_mR_pitch" type = "double" value = "0.1" />
        <param name = "nmpc_mR_yaw" type = "double"   value = "0.1" /> -->

        <param name = "nmpc_mQ_py" type = "double" value = "120" />
        <param name = "nmpc_mQ_px" type = "double" value = "130" />
        <param name = "nmpc_mQ_pz" type = "double" value = "160" />
        <param name = "nmpc_mQ_vx" type = "double" value = "1.0" />
        <param name = "nmpc_mQ_vy" type = "double" value = "1.0" />
        <param name = "nmpc_mQ_vz" type = "double" value = "1.0" />
        <param name = "nmpc_mQ_q1" type = "double" value = "3.0" />
        <param name = "nmpc_mQ_q2" type = "double" value = "3.0" />
        <param name = "nmpc_mQ_q3" type = "double" value = "3.0" />
        <param name = "nmpc_mQ_q4" type = "double" value = "3.0" />
        <param name = "nmpc_mR_a_BZ" type = "double"  value = "0.1" />
        <param name = "nmpc_mR_roll" type = "double"  value = "0.1" />
        <param name = "nmpc_mR_pitch" type = "double" value = "0.1" />
        <param name = "nmpc_mR_yaw" type = "double"   value = "0.1" />

        <param name = "nmpc_hover_thrust" type = "double"  value = "0.390" />

        <!-- For NMPC -->
        <!-- <param name = "nmpc_Qposx" type = "double" value = "40.0" />
        <param name = "nmpc_Qposy" type = "double" value = "40.0" />
        <param name = "nmpc_Qposz" type = "double" value = "40.0" />
        <param name = "nmpc_Qvelx" type = "double" value = "1.0" />
        <param name = "nmpc_Qvely" type = "double" value = "1.0" />
        <param name = "nmpc_Qvelz" type = "double" value = "1.0" />
        <param name = "nmpc_Qquatx" type = "double" value = "10.0" />
        <param name = "nmpc_Qquaty" type = "double" value = "10.0" />
        <param name = "nmpc_Qquatz" type = "double" value = "10.0" />
        <param name = "nmpc_Rwx" type = "double" value = "0.1" />
        <param name = "nmpc_Rwy" type = "double" value = "0.1" />
        <param name = "nmpc_Rwz" type = "double" value = "0.1" />
        <param name = "nmpc_RtotalF" type = "double" value = "0.1" /> -->

        <param name = "nmpc_Qposx" type = "double" value = "30.0" />
        <param name = "nmpc_Qposy" type = "double" value = "50.0" />
        <param name = "nmpc_Qposz" type = "double" value = "50.0" />
        <param name = "nmpc_Qvelx" type = "double" value = "1.0" /> 
        <param name = "nmpc_Qvely" type = "double" value = "1.0" />
        <param name = "nmpc_Qvelz" type = "double" value = "1.0" />
        <param name = "nmpc_Qquatx" type = "double" value = "1.0" />
        <param name = "nmpc_Qquaty" type = "double" value = "1.0" />
        <param name = "nmpc_Qquatz" type = "double" value = "10.0" />
        <param name = "nmpc_Rwx" type = "double" value = "0.3" />
        <param name = "nmpc_Rwy" type = "double" value = "0.3" />
        <param name = "nmpc_Rwz" type = "double" value = "0.3" />
        <param name = "nmpc_RtotalF" type = "double" value = "0.1" />

        <!-- ========== Trajectory Generator (internal, no ego-planner needed) ========== -->
        <!-- Set use_traj_gen=true to enable.  Works with cmd=5 when ego-planner is not running. -->
        <param name = "use_traj_gen" type = "bool"   value = "true" />
        <param name = "traj_type"    type = "string" value = "waypoint" />  <!-- circle | square | waypoint -->
        <param name = "traj_cx"      type = "double" value = "0.0" />
        <param name = "traj_cy"      type = "double" value = "0.0" />
        <param name = "traj_alt"     type = "double" value = "1.0" />
        <param name = "traj_param1"  type = "double" value = "2.0" />    <!-- circle→radius | square→side -->
        <param name = "traj_param2"  type = "double" value = "0.8" />    <!-- speed [m/s] -->
        <param name = "traj_hold_time" type = "double" value = "5.0" />    <!-- seconds to hover before motion -->

        <!-- ===== Custom waypoints for traj_type="waypoint" ===== -->
        <!-- Each waypoint is [x, y] or [x, y, yaw]. Uncomment to use. -->
        
        <rosparam param="traj_waypoints">
          - [0.0, 0.0, 0.0]
          - [2.0, 0.0, 0.0]
          - [2.0, 2.0, 0.0]
          - [0.0, 2.0, 0.0]
          - [0.0, 0.0, 0.0]
        </rosparam>
       

    </node>

</launch>
