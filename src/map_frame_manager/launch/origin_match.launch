<launch>
  <!-- Full pose matching exists only for one-time permanent-origin creation. -->
  <arg name="map_file" />
  <arg name="odom_topic" default="/Odometry" />
  <arg name="cloud_topic" default="/cloud_registered" />
  <arg name="global_odom_topic" default="/Odometry_lio_global" />
  <arg name="map_frame" default="lio_global" />
  <arg name="local_frame" default="world" />
  <arg name="body_frame" default="body" />
  <arg name="auto_initialize" default="false" />

  <node pkg="map_frame_manager" type="map_origin_matcher_node"
        name="map_frame_manager" output="screen" required="true">
    <rosparam command="load" file="$(find map_frame_manager)/config/origin_match.yaml" />
    <param name="map_file" value="$(arg map_file)" />
    <param name="odom_topic" value="$(arg odom_topic)" />
    <param name="cloud_topic" value="$(arg cloud_topic)" />
    <param name="global_odom_topic" value="$(arg global_odom_topic)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="local_frame" value="$(arg local_frame)" />
    <param name="body_frame" value="$(arg body_frame)" />
    <param name="auto_initialize" value="$(arg auto_initialize)" />
  </node>
</launch>
