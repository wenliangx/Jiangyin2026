<launch>
  <arg name="map_file" />
  <arg name="start_mapping" default="true" />
  <arg name="rviz" default="false" />
  <arg name="use_sim_time" default="false" />
  <arg name="auto_initialize" default="true" />
  <arg name="publish_to_original_odom_topic" default="false" />

  <include if="$(arg start_mapping)" file="$(find ra_lio)/launch/mapping_mid360.launch">
    <arg name="rviz" value="false" />
    <arg name="use_sim_time" value="$(arg use_sim_time)" />
    <arg name="global_output_en" value="$(arg publish_to_original_odom_topic)" />
  </include>

  <include file="$(find map_frame_manager)/launch/relocalize.launch">
    <arg name="map_file" value="$(arg map_file)" />
    <arg name="odom_topic"
         value="$(eval '/Odometry_local' if arg('publish_to_original_odom_topic') else '/Odometry')" />
    <arg name="cloud_topic"
         value="$(eval '/cloud_registered_local' if arg('publish_to_original_odom_topic') else '/cloud_registered')" />
    <arg name="map_frame"
         value="$(eval 'world' if arg('publish_to_original_odom_topic') else 'lio_global')" />
    <arg name="local_frame"
         value="$(eval 'lio_local' if arg('publish_to_original_odom_topic') else 'world')" />
    <arg name="body_frame" value="body" />
    <arg name="auto_initialize" value="$(arg auto_initialize)" />
    <arg name="publish_to_original_odom_topic" value="false" />
  </include>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find ra_lio)/rviz_cfg/mid360.rviz" />
</launch>
