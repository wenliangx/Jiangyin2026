        <param name="pub_rate" value="1.0"/>
        <param name="min_distance" value="0.8"/>
    </node> -->

    <include file="$(find ego_planner)/launch/include/run_in_sim.xml">
        <arg name="drone_id" value="0"/>
        <arg name="init_x" value="0.0"/>
        <arg name="init_y" value="0.0"/>
        <arg name="init_z" value="0.0"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <!-- " type 4 for flag test"/-->
        <arg name="flight_type" default="4"/>
        <arg name="point_num" default="5"/>
        <arg name="target0_x" default="-15.0"/>
        <arg name="target0_y" default="0.0"/>
        <arg name="target0_z" default="0.0"/>
        <arg name="target1_x" default="0.0"/>
        <arg name="target1_y" default="15.0"/>
        <arg name="target1_z" default="3.0"/>
        <arg name="target2_x" default="15.0"/>
        <arg name="target2_y" default="0.0"/>
        <arg name="target2_z" default="4.0"/>
        <arg name="target3_x" default="15.0"/>
        <arg name="target3_y" default="-7.0"/>
        <arg name="target3_z" default="2.0"/>
        <arg name="target4_x" default="3.0"/>
        <arg name="target4_y" default="-12.0"/>
        <arg name="target4_z" default="0.0"/>
    </include>

    <include file="$(find ego_planner)/launch/rviz_sim.launch"/>
</launch>

