<launch>
<!-- =============================================================================
  RA-LIO PCD 预加载定位 —— Livox MID360
  =============================================================================
  用法:
    roslaunch ra_lio localization_mid360.launch map_file_path:=/abs/path/GlobalMap.pcd

  启动后会先把 map_file_path 指向的 PCD 降采样并构建 ikd-Tree，
  第一帧点云不再初始化地图，而是直接进入 scan-to-map ESKF 更新。
  输出话题保持与 mapping_mid360.launch 一致。
  ============================================================================= -->

    <arg name="rviz" default="false" />
    <arg name="use_sim_time" default="false" />
    <arg name="map_file_path" default="" />
    <arg name="allow_map_update" default="false" />
    <arg name="initial_pose_from_odometry" default="true" />
    <arg name="initial_x" default="0.0" />
    <arg name="initial_y" default="0.0" />
    <arg name="initial_z" default="0.0" />
    <arg name="initial_roll" default="0.0" />
    <arg name="initial_pitch" default="0.0" />
    <arg name="initial_yaw" default="0.0" />

    <rosparam command="load" file="$(find ra_lio)/config/mid360.yaml" />

    <param name="feature_extract_enable" type="bool" value="0" />
    <param name="point_filter_num" type="int" value="2" />
    <param name="max_iteration" type="int" value="3" />
    <param name="filter_size_surf" type="double" value="0.05" />
    <param name="filter_size_map" type="double" value="0.05" />
    <param name="cube_side_length" type="double" value="1000" />

    <node pkg="ra_lio" type="ralio_mapping" name="laserMapping" output="screen">
        <param name="use_sim_time" value="$(arg use_sim_time)" />
        <param name="localization_mode" type="bool" value="true" />
        <param name="map_file_path" type="string" value="$(arg map_file_path)" />
        <param name="allow_map_update" type="bool" value="$(arg allow_map_update)" />
        <param name="initial_pose_from_odometry" type="bool" value="$(arg initial_pose_from_odometry)" />
        <rosparam param="initial_pose" subst_value="true">[$(arg initial_x), $(arg initial_y), $(arg initial_z), $(arg initial_roll), $(arg initial_pitch), $(arg initial_yaw)]</rosparam>
    </node>

    <group if="$(arg rviz)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find ra_lio)/rviz_cfg/mid360.rviz" />
    </group>
</launch>
