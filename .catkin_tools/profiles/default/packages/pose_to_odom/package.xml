<?xml version="1.0"?>
<package format="2">
  <name>pose_to_odom</name>
  <version>0.0.1</version>
  <description>Convert /mavros/local_position/pose (PoseStamped) to /Odometry (Odometry) for testing without LiDAR.</description>

  <maintainer email="intelnuc@todo.todo">intelnuc</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <export/>
</package>
